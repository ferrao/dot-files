#!/bin/bash

# Check if walker is installed
if ! command -v walker &>/dev/null; then
  echo "Error: walker is not installed" >&2
  exit 1
fi

ACCOUNT_FILE=~/.aws/accounts

labels=$(cat $ACCOUNT_FILE | cut -f 2 -d ',')
values=$(cat $ACCOUNT_FILE | cut -f 1 -d ',')

# Pass input to walker and capture the selected item
# Using --type dmenu to emulate dmenu-wl's menu behavior
index=$(( $(echo "$labels" | walker -d --index) + 1 ))
selection=$(echo "$values" | head -n $index | tail -n 1)

# Output the selected item to stdout
if [ -n "$selection" ]; then
  ydotool type $selection
else
  exit 1
fi
